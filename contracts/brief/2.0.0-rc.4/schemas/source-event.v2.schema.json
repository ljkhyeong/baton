{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brief.baton/contracts/schemas/source-event.v2.schema.json",
  "title": "SourceEventV2",
  "description": "BATON의 권위 있는 연속성 신호 상태를 BRIEF로 전달하는 이벤트 v2 요청입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "sourceSeverity",
    "workspaceId",
    "seasonId",
    "sourceReference",
    "aggregateRevision",
    "occurredAt",
    "state"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "ROLE_UNASSIGNED",
        "ROLE_SUCCESSOR_MISSING",
        "ROLE_PREPARATION_INCOMPLETE",
        "ROUTINE_REPEATEDLY_OVERDUE",
        "HANDOFF_INCOMPLETE"
      ]
    },
    "eventVersion": {
      "const": 2
    },
    "sourceSeverity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "WARNING"
      ]
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "seasonId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceReference": {
      "description": "공백 판정은 JDK 21 Character.isWhitespace 기준입니다. U+0000과 짝이 없는 UTF-16 surrogate는 허용하지 않습니다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        {
          "pattern": "[^\\u0009-\\u000D\\u001C-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200A\\u2028-\\u2029\\u205F\\u3000]"
        },
        {
          "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
        }
      ]
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{1,9})?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "RESOLVED"
      ]
    }
  }
}
