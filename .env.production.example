# Public DNS name whose A/AAAA record points at this host.
BATON_HOST=

# Keep the database name or choose another non-secret name.
BATON_DB_NAME=baton

# Fill every required value with simple unquoted literals. Generate each password
# and workspace key independently; `openssl rand -hex 32` produces an accepted value.
BATON_DB_USERNAME=
BATON_DB_PASSWORD=
BATON_DB_ROOT_PASSWORD=
BATON_WORKSPACE_CREATION_KEY=
BATON_WORKSPACE_RECOVERY_KEY=

# WATCH is optional. Keep false until the service URL, a separately generated
# bearer token, and a stable environment namespace are ready.
BATON_WATCH_ENABLED=false
# Keep the transport enabled and set this to false first when decommissioning
# monitors. Disable BATON_WATCH_ENABLED only after reconciliation is delivered.
BATON_WATCH_MONITORING_ENABLED=true
# BATON_WATCH_BASE_URL=https://watch.example.com
# BATON_WATCH_BEARER_TOKEN=
# BATON_WATCH_SOURCE_NAMESPACE=production

# WATCH health-change event 수신은 별도 방향의 연동이며 기본 비활성화한다.
# 활성화할 때 위 source namespace와 outbound token과 다른 전용 token을 사용한다.
BATON_WATCH_EVENT_RECEIVER_ENABLED=false
# BATON_WATCH_EVENT_RECEIVER_BEARER_TOKEN=

# Google OIDC와 Naver OAuth2는 함께 구성한 뒤 한 번에 활성화한다. Client secret은
# 이 env에 넣지 않고 owner-only host 파일의 절대 경로만 기록한다.
BATON_AUTH_OAUTH2_ENABLED=false
# BATON_AUTH_OAUTH2_GOOGLE_CLIENT_ID=
# BATON_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET_FILE=/srv/baton/secrets/google-oauth-client-secret
# BATON_AUTH_OAUTH2_NAVER_CLIENT_ID=
# BATON_AUTH_OAUTH2_NAVER_CLIENT_SECRET_FILE=/srv/baton/secrets/naver-oauth-client-secret

# 자체 이메일 가입은 SMTP를 먼저 검증한 뒤 마지막에 연다. Secret 파일과 그 parent
# directory는 현재 운영 사용자 소유이며 각각 0600, 0700이어야 한다.
BATON_AUTH_LOCAL_REGISTRATION_ENABLED=false
BATON_EMAIL_VERIFICATION_DELIVERY=disabled
# production outbox row에 raw token을 남기지 않기 위한 안정적인 AES-256-GCM key다.
BATON_EMAIL_OUTBOX_ENCRYPTION_KEY_FILE=/srv/baton/secrets/email-outbox-encryption-key.base64
# BATON_EMAIL_FROM_ADDRESS=no-reply@example.com
# BATON_SMTP_HOST=smtp.example.com
# BATON_SMTP_PORT=587
# BATON_SMTP_USERNAME=no-reply@example.com
# BATON_SMTP_PASSWORD_FILE=/srv/baton/secrets/smtp-password

# ROUND signing key는 PKCS#8 PRIVATE KEY와 대응하는 RSA PUBLIC KEY PEM이다.
# 새 public key를 previous slot으로 먼저 게시하고 cache가 갱신된 뒤 signer를 전환한다.
BATON_ROUND_PARTICIPATION_GRANT_ENABLED=false
# BATON_ROUND_PARTICIPATION_GRANT_CURRENT_KID=round-2026-08
# BATON_ROUND_PARTICIPATION_GRANT_PRIVATE_KEY_FILE=/srv/baton/secrets/round-current-private.pem
# BATON_ROUND_PARTICIPATION_GRANT_PUBLIC_KEY_FILE=/srv/baton/secrets/round-current-public.pem
# BATON_ROUND_PARTICIPATION_GRANT_PREVIOUS_KID=round-2026-07
# BATON_ROUND_PARTICIPATION_GRANT_PREVIOUS_PUBLIC_KEY_FILE=/srv/baton/secrets/round-previous-public.pem
