# 이 호스트를 가리키는 A/AAAA 레코드의 공개 DNS 이름이다.
BATON_HOST=b4ton.com

# 이 데이터베이스 이름을 유지하거나 비밀값이 아닌 다른 이름을 선택한다.
BATON_DB_NAME=baton

# 모든 필수값을 따옴표 없는 단순 리터럴로 채운다. 각 비밀번호와 워크스페이스 키는
# 독립적으로 생성하며 `openssl rand -hex 32`의 출력은 허용되는 값이다.
BATON_DB_USERNAME=
BATON_DB_PASSWORD=
BATON_DB_ROOT_PASSWORD=
BATON_WORKSPACE_CREATION_KEY=
BATON_WORKSPACE_RECOVERY_KEY=

# 공공데이터포털 ‘한국천문연구원_특일 정보’의 일반 인증키(Decoding)를 사용한다.
BATON_HOLIDAYS_ENABLED=false
# BATON_HOLIDAYS_SERVICE_KEY_FILE=/srv/baton/secrets/holidays-service-key

# CAL은 선택 기능이다. 캡처를 먼저 켜고 보정을 한 번 완료한 뒤 보정은 다시 끈다.
# 마지막에 전달을 활성화한다. Bearer 토큰 원문은 이 파일에 넣지 않고 운영자 전용
# 호스트 파일의 절대 경로만 기록한다.
BATON_CAL_CAPTURE_ENABLED=false
BATON_CAL_BACKFILL_ENABLED=false
BATON_CAL_RECOVERY_PREPARATION_ENABLED=false
BATON_CAL_RECOVERY_RUN_ID=
BATON_CAL_DELIVERY_ENABLED=false
BATON_CAL_SEASON_METADATA_ENABLED=false
BATON_CAL_SEASON_METADATA_MAINTENANCE=OFF
# BATON_CAL_BASE_URL=https://cal.b4ton.com
# BATON_CAL_BEARER_TOKEN_FILE=/srv/baton/secrets/cal-bearer-token

# WATCH는 선택 기능이다. 서비스 URL, 별도로 생성한 Bearer 토큰과 안정적인 환경
# 이름공간을 준비할 때까지 false로 유지한다.
BATON_WATCH_ENABLED=false
# 모니터를 폐기할 때는 전송 기능을 유지한 채 이 값을 먼저 false로 바꾼다.
# 조정 결과가 전달된 뒤에만 BATON_WATCH_ENABLED를 비활성화한다.
BATON_WATCH_MONITORING_ENABLED=true
# BATON_WATCH_BASE_URL=https://watch.b4ton.com
# BATON_WATCH_BEARER_TOKEN=
# BATON_WATCH_SOURCE_NAMESPACE=production

# WATCH 상태 변경 이벤트 수신은 별도 방향의 연동이며 기본 비활성화한다.
# 활성화할 때 위 소스 이름공간과 외부 전송 토큰과 다른 전용 토큰을 사용한다.
BATON_WATCH_EVENT_RECEIVER_ENABLED=false
# BATON_WATCH_EVENT_RECEIVER_BEARER_TOKEN=

# BRIEF 이벤트 전달은 외부 HTTPS origin과 전용 Bearer 비밀 파일을 준비한 뒤 활성화한다.
# token 교체 때는 BRIEF에 새 값과 직전 값을 먼저 배포한 뒤 BATON 파일을 새 값으로 바꾼다.
BATON_BRIEF_DELIVERY_ENABLED=false
# BATON_BRIEF_BASE_URL=https://brief.b4ton.com
# BATON_BRIEF_BEARER_TOKEN_FILE=/srv/baton/secrets/brief-event-receiver-bearer-token
# 시간 경계 재조정이 필요하면 양의 ISO-8601 Duration을 명시한다.
# BATON_BRIEF_RECONCILIATION_INTERVAL=PT5M

# BRIEF 사용자 조회·에디션 생성은 이벤트 전달과 다른 선택 기능이다. BRIEF 서비스 Caddy의
# 인증서 SAN과 같은 내부 호스트, 별도 Bearer와 해당 인증서를 담은 PKCS12 truststore를
# 준비한 뒤 활성화한다. truststore는 비밀 키 없이 인증서만 담고 비밀번호는 changeit이다.
BATON_BRIEF_SERVICE_API_ENABLED=false
# BATON_BRIEF_SERVICE_HOST=brief-service
# BATON_BRIEF_PRIVATE_NETWORK=baton-brief-private
# BATON_BRIEF_SERVICE_API_BEARER_TOKEN_FILE=/srv/baton/secrets/brief-service-api-bearer-token
# BATON_BRIEF_SERVICE_TRUSTSTORE_FILE=/srv/baton/secrets/brief-service-truststore.p12

# Google OIDC와 Naver OAuth2는 함께 구성한 뒤 한 번에 활성화한다. 클라이언트 비밀값은
# 이 환경 설정에 넣지 않고 운영자 전용 호스트 파일의 절대 경로만 기록한다.
BATON_AUTH_OAUTH2_ENABLED=false
# BATON_AUTH_OAUTH2_GOOGLE_CLIENT_ID=
# BATON_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET_FILE=/srv/baton/secrets/google-oauth-client-secret
# BATON_AUTH_OAUTH2_NAVER_CLIENT_ID=
# BATON_AUTH_OAUTH2_NAVER_CLIENT_SECRET_FILE=/srv/baton/secrets/naver-oauth-client-secret

# 자체 이메일 가입은 SMTP를 먼저 검증한 뒤 마지막에 연다. 비밀 파일과 그 상위
# 디렉터리는 현재 운영 사용자 소유이며 각각 0600, 0700이어야 한다.
BATON_AUTH_LOCAL_REGISTRATION_ENABLED=false
BATON_AUTH_PASSWORD_RESET_ENABLED=false
BATON_EMAIL_VERIFICATION_DELIVERY=disabled
# 공개 가입·재설정 요청의 Turnstile 검증이다. 비밀 키는 저장소 밖 0600 파일에 둔다.
BATON_TURNSTILE_ENABLED=false
# BATON_TURNSTILE_SITE_KEY=<공개 사이트 키>
# BATON_TURNSTILE_SECRET_KEY_FILE=/srv/baton/secrets/turnstile-secret-key
# BATON_TURNSTILE_EXPECTED_HOSTNAME=b4ton.com
# 프로덕션 아웃박스 행에 원문 토큰을 남기지 않기 위한 안정적인 AES-256-GCM 키다.
BATON_EMAIL_OUTBOX_ENCRYPTION_KEY_FILE=/srv/baton/secrets/email-outbox-encryption-key.base64
# Sentry Developer 무료 플랜: DSN을 비워 두면 오류를 전송하지 않는다. 브라우저 DSN은 공개 설정이다.
BATON_SENTRY_DSN=
BATON_SENTRY_BROWSER_DSN=
BATON_SENTRY_ENVIRONMENT=production
# status.b4ton.com 공개 확인 후 켠다. 변경 시 웹 이미지를 다시 빌드한다.
BATON_STATUS_PAGE_ENABLED=false
# Brevo SMTP 최종 전달 결과. 발송과 다른 전용 토큰을 사용한다.
BATON_BREVO_WEBHOOK_ENABLED=false
# BATON_BREVO_WEBHOOK_BEARER_TOKEN_FILE=/srv/baton/secrets/brevo-webhook-token
# 무료 Brevo SMTP 연결은 docs/runbooks/free-integrations.md를 참고한다.
# BATON_EMAIL_FROM_ADDRESS=no-reply@b4ton.com
# BATON_SMTP_HOST=smtp-relay.brevo.com
# BATON_SMTP_PORT=587
# BATON_SMTP_USERNAME=<Brevo에서 발급한 SMTP 로그인>
# BATON_SMTP_PASSWORD_FILE=/srv/baton/secrets/smtp-password

# ROUND 런타임은 두 릴리스 이미지와 TURN 설정을 모두 검증한 뒤 별도로 연다.
# 이미지는 태그가 아니라 정확한 repository@sha256:<64 lowercase hex> 참조를 쓰고,
# 리비전은 두 이미지의 org.opencontainers.image.revision 레이블과 같아야 한다.
BATON_ROUND_RUNTIME_ENABLED=false
# BATON_ROUND_WEB_IMAGE=registry.example.com/round/round-baton-web@sha256:<64-lowercase-hex-digest>
# BATON_ROUND_SIGNALING_IMAGE=registry.example.com/round/round-signaling@sha256:<64-lowercase-hex-digest>
# BATON_ROUND_RELEASE_REVISION=<40-lowercase-hex-git-revision>
# BATON_ROUND_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN 공유 비밀 파일은 운영자 전용이며 줄바꿈 없는 `openssl rand -hex 32` 결과만 담는다.
# BATON_ROUND_TURN_SHARED_SECRET_FILE=/srv/baton/secrets/round-turn-shared-secret

# ROUND 서명 키는 PKCS#8 PRIVATE KEY와 대응하는 RSA PUBLIC KEY PEM이다.
# 런타임만 먼저 비공개로 배포한 뒤 참여권을 활성화한다. 새 공개 키를 이전 키 슬롯으로
# 먼저 게시하고 캐시가 갱신된 뒤 서명자를 전환한다.
BATON_ROUND_PARTICIPATION_GRANT_ENABLED=false
# BATON_ROUND_PARTICIPATION_GRANT_CURRENT_KID=round-2026-08
# BATON_ROUND_PARTICIPATION_GRANT_PRIVATE_KEY_FILE=/srv/baton/secrets/round-current-private.pem
# BATON_ROUND_PARTICIPATION_GRANT_PUBLIC_KEY_FILE=/srv/baton/secrets/round-current-public.pem
# BATON_ROUND_PARTICIPATION_GRANT_PREVIOUS_KID=round-2026-07
# BATON_ROUND_PARTICIPATION_GRANT_PREVIOUS_PUBLIC_KEY_FILE=/srv/baton/secrets/round-previous-public.pem
