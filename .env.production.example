# Public DNS name whose A/AAAA record points at this host.
BATON_HOST=

# Keep the database name or choose another non-secret name.
BATON_DB_NAME=baton

# Fill every required value with simple unquoted literals. Generate each password,
# workspace key and identity secret independently; `openssl rand -hex 32` produces
# an accepted value.
BATON_DB_USERNAME=
BATON_DB_PASSWORD=
BATON_DB_ROOT_PASSWORD=
BATON_WORKSPACE_CREATION_KEY=
BATON_WORKSPACE_RECOVERY_KEY=
BATON_IDENTITY_BOOTSTRAP_KEY=
BATON_IDENTITY_INVITATION_HMAC_SECRET=
BATON_IDENTITY_BOOTSTRAP_INVITATION_TTL=PT1H
BATON_IDENTITY_MEMBER_INVITATION_TTL=PT24H

# OIDC is disabled until all three Google registration values are supplied.
BATON_IDENTITY_OIDC_ENABLED=false
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI={baseUrl}/api/v1/auth/oidc/callback/{registrationId}

# Keep disabled until BATON GO and ROUND have public HTTPS origins. When enabling,
# uncomment all four values and use the same management token configured in GO.
BATON_GO_ENABLED=false
# BATON_GO_BASE_URL=https://go.example.com
# BATON_GO_PUBLIC_BASE_URL=https://go.example.com
# BATON_GO_MANAGEMENT_TOKEN=
# BATON_ROUND_PUBLIC_BASE_URL=https://round.example.com

# ROUND의 BATON 참여권과 same-origin edge는 GO·OIDC를 먼저 활성화한 뒤 켠다.
# 공개 ROUND origin은 반드시 https://${BATON_HOST}와 같아야 한다. 이미지에는
# release tag가 아니라 검증한 multi-arch digest를 사용한다.
BATON_ROUND_GRANT_ENABLED=false
# BATON_ROUND_GRANT_ACTIVE_KID=round-2026-01
# BATON_ROUND_GRANT_PRIVATE_KEY_FILE=/absolute/path/to/round-signing-key.pem
# BATON_ROUND_GRANT_JWK_SET_FILE=/absolute/path/to/round-jwks.json
# BATON_ROUND_WEB_IMAGE=ghcr.io/example/round-baton-web@sha256:
# BATON_ROUND_SIGNALING_IMAGE=ghcr.io/example/round-signaling@sha256:
# BATON_ROUND_TURN_URLS=turns:turn.example.com:5349?transport=tcp
# BATON_ROUND_TURN_SHARED_SECRET=
