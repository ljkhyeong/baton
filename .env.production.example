# Public DNS name whose A/AAAA record points at this host.
BATON_HOST=

# Keep the database name or choose another non-secret name.
BATON_DB_NAME=baton

# Fill every required value with simple unquoted literals. Generate each password
# and workspace key independently; `openssl rand -hex 32` produces an accepted value.
BATON_DB_USERNAME=
BATON_DB_PASSWORD=
BATON_DB_ROOT_PASSWORD=
BATON_WORKSPACE_CREATION_KEY=
BATON_WORKSPACE_RECOVERY_KEY=

# Keep disabled until BATON GO and ROUND have public HTTPS origins. When enabling,
# uncomment all four values and use the same management token configured in GO.
BATON_GO_ENABLED=false
# BATON_GO_BASE_URL=https://go.example.com
# BATON_GO_PUBLIC_BASE_URL=https://go.example.com
# BATON_GO_MANAGEMENT_TOKEN=
# BATON_ROUND_PUBLIC_BASE_URL=https://round.example.com
