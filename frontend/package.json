{
  "name": "baton-org-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api:generate": "openapi-typescript ../docs/api/openapi3.yaml --output src/generated/api.ts --alphabetize",
    "api:check": "openapi-typescript ../docs/api/openapi3.yaml --output src/generated/api.ts --alphabetize --check",
    "api:validate": "node scripts/validate-openapi.mjs ../docs/api/openapi3.yaml",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:operations": "playwright test --grep @operations",
    "e2e:memory": "playwright test --grep @memory",
    "e2e:handoff": "playwright test --grep @handoff",
    "e2e:responsive": "playwright test --grep @responsive",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "bootstrap": "^5.3.8",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "js-yaml": "4.3.0",
    "openapi-typescript": "7.13.0",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.1"
  }
}
