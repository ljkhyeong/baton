{
  "name": "baton-org-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "api:generate": "openapi-typescript ../docs/api/openapi3.yaml --output src/generated/api.ts --alphabetize",
    "api:check": "openapi-typescript ../docs/api/openapi3.yaml --output src/generated/api.ts --alphabetize --check",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:sourcemaps": "node --test tests/sentry-sourcemaps.test.mjs",
    "e2e": "playwright test",
    "e2e:focus": "playwright test --project=chromium --workers=2 --max-failures=1",
    "e2e:failed": "playwright test --last-failed --workers=2",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:operations": "playwright test --grep @operations",
    "e2e:memory": "playwright test --grep @memory",
    "e2e:handoff": "playwright test --grep @handoff",
    "e2e:records": "playwright test --grep @records",
    "e2e:responsive": "playwright test --grep @responsive",
    "e2e:fullstack": "bash scripts/run-fullstack-e2e.sh",
    "e2e:round-edge": "bash scripts/run-round-edge-e2e.sh",
    "e2e:fullstack:test": "playwright test --config playwright.fullstack.config.ts",
    "e2e:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@sentry/react": "10.74.0",
    "@tanstack/react-query": "^5.90.21",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sentry/vite-plugin": "5.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "js-yaml": "4.3.0",
    "openapi-typescript": "7.13.0",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.1"
  }
}
