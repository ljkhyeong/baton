global:
  smtp_smarthost: smtp-relay.brevo.com:587
  smtp_from: no-reply@b4ton.com
  smtp_auth_username: REPLACE_WITH_SMTP_LOGIN
  smtp_auth_password_file: /run/secrets/smtp-password
  smtp_require_tls: true

route:
  receiver: operations-email
  group_by: [job, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    - receiver: monitoring-heartbeat
      matchers: ['alertname="BatonMonitoringWatchdog"']
      group_by: [alertname]
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m

receivers:
  - name: operations-email
    email_configs:
      - to: replace-with-operator@example.invalid
        send_resolved: true
  - name: monitoring-heartbeat
    webhook_configs:
      - url_file: /run/secrets/monitoring-heartbeat-url
        send_resolved: false
        max_alerts: 1
        timeout: 10s
        http_config:
          follow_redirects: false
