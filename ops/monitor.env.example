# systemd EnvironmentFile 값에는 셸 확장이 적용되지 않으므로 절대 경로를 사용한다.
BATON_REPO_ROOT=/absolute/path/to/baton
BATON_PRODUCTION_ENV_FILE=/absolute/path/to/baton/.env.production
BATON_BACKUP_STATE_DIR=/absolute/path/to/baton-backup-state

# 검사가 DNS, 신뢰할 수 있는 TLS, Caddy, Spring과 DB 상태를 거치도록 공개 URL을 사용한다.
BATON_HEALTH_URL=https://baton.example.com/actuator/health
BATON_HEALTH_CONNECT_TIMEOUT_SECONDS=5
BATON_HEALTH_TIMEOUT_SECONDS=15

# 완전히 검증된 최신 원격 스냅샷은 이 시간 이내여야 한다.
BATON_BACKUP_MAX_AGE_HOURS=36

# CAL·WATCH 전달 지표는 이 시간 안에 한 번 이상 정상 갱신돼야 한다.
BATON_INTEGRATION_METRICS_MAX_STALENESS_SECONDS=120
