# systemd EnvironmentFile values are not shell-expanded. Use absolute paths.
BATON_REPO_ROOT=/absolute/path/to/baton
BATON_BACKUP_STATE_DIR=/absolute/path/to/baton-backup-state

# Use the public URL so the check traverses DNS, trusted TLS, Caddy, Spring, and DB health.
BATON_HEALTH_URL=https://baton.example.com/actuator/health
BATON_HEALTH_CONNECT_TIMEOUT_SECONDS=5
BATON_HEALTH_TIMEOUT_SECONDS=15

# The latest fully verified off-site snapshot must stay within this age.
BATON_BACKUP_MAX_AGE_HOURS=36
