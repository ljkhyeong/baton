# systemd EnvironmentFile values are not shell-expanded. Use absolute paths.
BATON_REPO_ROOT=/absolute/path/to/baton
BATON_ENV_FILE=/absolute/path/to/baton/.env.production
BATON_BACKUP_DIR=/absolute/path/to/baton-backups
# The backup cycle and restore share an owner-only lock inside this directory.
BATON_BACKUP_STATE_DIR=/absolute/path/to/baton-backup-state

# Configure this as an rclone crypt remote backed by a dedicated off-site path.
BATON_RCLONE_REMOTE=baton_crypt:daily

# Local files are removed only after every pending backup and checksum is uploaded.
# Remote objects are never deleted by BATON scripts.
BATON_BACKUP_LOCAL_RETENTION_DAYS=14

# A monitoring check fails when the newest fully verified snapshot is older than this.
BATON_BACKUP_MAX_AGE_HOURS=36

# Optional when the service user does not use rclone's default config path.
# RCLONE_CONFIG=/absolute/path/to/rclone.conf

# Optional for an encrypted rclone config. The command must print the config password non-interactively.
# RCLONE_PASSWORD_COMMAND=/absolute/path/to/rclone-password-command
