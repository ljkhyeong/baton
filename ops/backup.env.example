# systemd EnvironmentFile 값에는 셸 확장이 적용되지 않으므로 절대 경로를 사용한다.
BATON_REPO_ROOT=/absolute/path/to/baton
BATON_PRODUCTION_ENV_FILE=/absolute/path/to/baton/.env.production
BATON_BACKUP_DIR=/absolute/path/to/baton-backups
# 백업 주기와 복구는 이 디렉터리 안의 운영자 전용 잠금을 공유한다.
BATON_BACKUP_STATE_DIR=/absolute/path/to/baton-backup-state

# 전용 원격 경로를 사용하는 rclone crypt 원격 저장소로 설정한다.
BATON_RCLONE_REMOTE=baton_crypt:daily

# 대기 중인 모든 백업과 체크섬을 업로드한 뒤에만 로컬 파일을 제거한다.
# BATON 스크립트는 원격 객체를 삭제하지 않는다.
BATON_BACKUP_LOCAL_RETENTION_DAYS=14

# 선택: Better Stack 무료 하트비트의 비밀 URL을 담은 0600 파일.
# 새 백업과 원격 검증이 모두 끝나야 완료 신호를 보낸다.
# BATON_BACKUP_HEARTBEAT_URL_FILE=/srv/baton/secrets/backup-heartbeat-url

# 서비스 사용자가 rclone 기본 설정 경로를 사용하지 않을 때 선택적으로 지정한다.
# RCLONE_CONFIG=/absolute/path/to/rclone.conf

# 암호화한 rclone 설정에 선택적으로 지정한다. 명령은 설정 비밀번호를 비대화형으로 출력해야 한다.
# RCLONE_PASSWORD_COMMAND=/absolute/path/to/rclone-password-command
