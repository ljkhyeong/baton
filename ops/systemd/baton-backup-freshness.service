[Unit]
Description=Check BATON off-site backup freshness

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/baton/monitor.env
ExecStart=/usr/bin/env bash ${BATON_REPO_ROOT}/ops/check-backup-freshness.sh
UMask=0077
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baton-backup-freshness
