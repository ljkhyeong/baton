[Unit]
Description=BATON database backup and off-site synchronization
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/baton/backup.env
ExecStart=/usr/bin/env bash ${BATON_REPO_ROOT}/ops/backup-cycle.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baton-backup
