root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.java]
indent_style = space
indent_size = 4

[*.gradle]
indent_style = tab
tab_width = 4

[*.{css,html,json,js,jsx,scss,ts,tsx,yaml,yml}]
indent_style = space
indent_size = 2
